<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream Component Metadata (Metainfo)
     Spec: https://www.freedesktop.org/software/appstream/docs/
     Lint: appstreamcli validate aura-launcher.metainfo.xml
-->
<component type="desktop-application">
    <id>io.github.kitty_hivens.auralauncher</id>

    <name>Aura Launcher</name>
    <summary>Launch and manage your Aura games</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <description>
        <p>
            Aura Launcher is an unofficial third-party client for the Aura platform. It handles
            authentication, game library management, automatic updates, and launching
            your Aura titles — all from a single, lightweight application.
        </p>
    </description>

    <url type="homepage">https://github.com/Kitty-Hivens/Aura-Launcher</url>
    <url type="bugtracker">https://github.com/Kitty-Hivens/Aura-Launcher/issues</url>

    <developer_name>Hivens</developer_name>

    <!-- Launchable ties this metainfo to the .desktop file -->
    <launchable type="desktop-id">aura-launcher.desktop</launchable>

    <provides>
        <binary>aura-launcher</binary>
    </provides>

    <categories>
        <category>Game</category>
    </categories>

    <keywords>
        <keyword>launcher</keyword>
        <keyword>game</keyword>
        <keyword>hivens</keyword>
        <keyword>aura</keyword>
    </keywords>

    <content_rating type="oars-1.1"/>

    <!-- Minimum display requirements -->
    <requires>
        <display_length compare="ge">768</display_length>
    </requires>

    <releases>
        <release version="1.0.0" date="2026-02-21">
            <description><p>Initial release support</p></description>
        </release>
    </releases>
</component>
