<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream Component Metadata (Metainfo)
     Spec: https://www.freedesktop.org/software/appstream/docs/
     Lint: appstreamcli validate aura-launcher.metainfo.xml
-->
<component type="desktop-application">
    <id>io.github.kitty_hivens.AuraLauncher</id>

    <name>Aura Launcher</name>
    <summary>Launch and manage your Aura games</summary>

    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later</project_license>

    <description>
        <p>
            Aura Launcher is an unofficial third-party client for the Aura platform. It handles
            authentication, game library management, automatic updates, and launching
            your Aura titles — all from a single, lightweight application.
        </p>
        <p>Features include:</p>
        <ul>
            <li>One-click game installation and updates</li>
            <li>Offline mode support</li>
            <li>Over-the-air self-updates with automatic rollback on failure</li>
            <li>Customisable game launch options</li>
        </ul>
    </description>

    <url type="homepage">https://github.com/Kitty-Hivens/Aura-Launcher</url>
    <url type="bugtracker">https://github.com/Kitty-Hivens/Aura-Launcher/issues</url>
    <url type="vcs-browser">https://github.com/Kitty-Hivens/Aura-Launcher</url>

    <developer id="io.github.kitty_hivens">
        <name>Hivens</name>
    </developer>

    <!-- Launchable ties this metainfo to the .desktop file -->
    <launchable type="desktop-id">aura-launcher.desktop</launchable>

    <provides>
        <binary>aura-launcher</binary>
    </provides>

    <screenshots>
        <screenshot type="default">
            <caption>Main launcher window</caption>
            <image>https://raw.githubusercontent.com/Kitty-Hivens/Aura-Launcher/stable/docs/screenshots/main.png</image>
        </screenshot>
    </screenshots>

    <categories>
        <category>Game</category>
    </categories>

    <keywords>
        <keyword>launcher</keyword>
        <keyword>game</keyword>
        <keyword>hivens</keyword>
        <keyword>aura</keyword>
    </keywords>

    <content_rating type="oars-1.1"/>

    <!-- Minimum display requirements -->
    <requires>
        <display_length compare="ge">768</display_length>
    </requires>

    <releases>
        <!-- Populated automatically by the release workflow via appstreamcli -->
        <!-- Example entry (remove before publishing; CI will inject real ones):
