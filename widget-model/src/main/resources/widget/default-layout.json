{
  "schema_version": 6,
  "graph": {
    "surfaces": {
      "appshell.root": {
        "slots": {
          "regions": {
            "orientation": "Column",
            "widgets": [
              { "kind": "appshell.region.top",  "instance_id": "appshell-region-top-default" },
              { "kind": "appshell.region.body", "instance_id": "appshell-region-body-default", "weight": 1.0 }
            ]
          }
        }
      },
      "appshell.body": {
        "slots": {
          "content": {
            "orientation": "Row",
            "widgets": [
              { "kind": "appshell.region.left",   "instance_id": "appshell-region-left-default",   "props": { "widthDp": 65 } },
              { "kind": "appshell.region.center", "instance_id": "appshell-region-center-default", "weight": 1.0 },
              { "kind": "appshell.region.right",  "instance_id": "appshell-region-right-default",  "props": { "widthDp": 265 } }
            ]
          }
        }
      },
      "appshell.topbar": {
        "slots": {
          "left": { "orientation": "Row", "widgets": [ { "kind": "appshell.topbar.breadcrumb", "instance_id": "appshell-topbar-breadcrumb-default" } ] }
        }
      },
      "home.classic": {
        "slots": {
          "main": {
            "widgets": [
              { "kind": "home.classic.content", "instance_id": "home-classic-content-default" }
            ]
          }
        }
      },
      "home.new": {
        "slots": {
          "main": {
            "widgets": [
              { "kind": "home.new.welcome",     "instance_id": "home-new-welcome-default" },
              { "kind": "home.new.spacer",      "instance_id": "home-new-spacer-default" },
              { "kind": "home.new.recent",      "instance_id": "home-new-recent-default" },
              { "kind": "home.new.quicklaunch", "instance_id": "home-new-quicklaunch-default" }
            ]
          }
        }
      },
      "library": {
        "slots": {
          "header": {
            "widgets": [
              { "kind": "library.header", "instance_id": "library-header-default" }
