<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of the launcher's is copied off the device, to the cloud or to a new phone.
    allowBackup="false" stopped both until Android 12, which kept it for the cloud only:
    a device transfer would carry the data over, and the secrets in it, sealed with a
    Keystore key that stays behind, would arrive unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
