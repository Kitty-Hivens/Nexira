# EditorConfig — see https://editorconfig.org/ for spec.
# Pinned defaults so contributors don't have to discover ours by accident.

root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

# Kotlin / Java / Gradle
[*.{kt,kts,java}]
max_line_length                          = 120
ij_kotlin_continuation_indent_size       = 4
ij_kotlin_allow_trailing_comma           = true
ij_kotlin_allow_trailing_comma_on_call_site = true
ij_kotlin_imports_layout                 = *
# Decorative Unicode in code comments stays (visual hierarchy):
#   ※ ◆ ❖ ── ━━ ─ 『 』 「 」  -- structural / ornamental
# Prose Unicode in code comments is normalised to ASCII (since 2026-05-16):
#   —  (em-dash, U+2014)  -> --
#   →  (right arrow)      -> ->
#   ←  (left arrow)       -> <-
# i18n strings (client-ui/src/.../i18n/*Strings.kt) are exempt -- user-facing
# UI text renders Unicode correctly and prose Unicode is appropriate there.
ij_visual_guides                         = 120

# YAML / JSON / TOML — 2 spaces is the community default
[*.{yml,yaml,json,toml}]
indent_size = 2

# Markdown — trailing whitespace is a linebreak in MD; don't trim.
[*.md]
trim_trailing_whitespace = false
indent_size              = 2
